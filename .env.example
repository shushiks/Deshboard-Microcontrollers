# Generate a long random value, for example: openssl rand -hex 32
ESP_API_KEY=replace-with-a-long-random-secret

# Identify your deployment when the server asks the geocoding provider for an address.
GEOCODING_USER_AGENT=ESP-Fleet-Monitor/1.0 (your-email@example.com)
WRITE_RATE_LIMIT_PER_MINUTE=120
